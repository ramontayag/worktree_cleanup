#!/usr/bin/env ruby
# frozen_string_literal: true

Dir.chdir(File.expand_path("..", __dir__)) do
  files = ARGV.select { |argument| argument.end_with?("_test.rb") }
  ARGV.reject! { |argument| files.include?(argument) }
  files = Dir["test/**/*_test.rb"].sort if files.empty?
  files.each { |file| require File.expand_path(file) }
end
